# OpenAI API key (required for real scene generation; omit to use mock)
OPENAI_API_KEY=your_openai_api_key_here

# Pika API key (optional; mock is used by default)
PIKA_API_KEY=your_pika_api_key_here

# ElevenLabs API key (optional; silence audio is used if omitted)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs voice ID (optional; defaults to "Rachel")
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Server port
PORT=3001
